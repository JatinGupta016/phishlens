{
  "builds": [
    { 
      "src": "api/index.py", 
      "use": "@vercel/python",
      "config": { "installCommand": "pip install -r reqs.txt" }
    },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
